#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// AML クリックしたときにタイムアウトを延長

&mkp_input_listener { input-processors = <&zip_temp_layer 6 10000>; };

/ {
    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        LT_MOUSE {
            bindings = <&to 6>;
            key-positions = <16 17>;
        };

        TL_DEFAULT {
            bindings = <&to 0>;
            key-positions = <17 18>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        // Kyemap Editor用

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        // DYA Studio用

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E    &kp R             &kp T                                             &kp Y        &kp U            &kp I       &kp O       &kp P
&kp A             &kp S         &kp D    &kp F             &kp G                                             &lt 5 H      &kp J            &kp K       &kp L       &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C    &kp V             &kp B                                             &kp N        &kp M            &kp COMMA   &kp PERIOD  &kp SLASH
&kp LEFT_WIN      &kp LEFT_ALT  &kp TAB  &lt 3 LANG_HANJA  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT LANG1      &lt 1 ENTER  &lt 2 BACKSPACE  &kp ESCAPE  &kp DELETE  &kp BACKSLASH
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        ARROW_DEVICE {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4             &kp LC(V)  &kp HOME           &kp UP_ARROW    &kp END          &none
&none           &none         &none         &none         &none                    &kp LC(C)  &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT_SHIFT
&bt BT_CLR      &none         &none         &none         &bootloader              &kp LC(X)  &kp C_VOLUME_DOWN  &kp C_VOL_DN    &none            &none
&bt BT_CLR_ALL  &none         &none         &none         &none         &none      &none      &none              &none           &none            &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        NUM_FUNCTION {
            bindings = <
&none  &kp F7  &kp F8  &kp F9  &kp F12             &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp PLUS
&none  &kp F4  &kp F5  &kp F6  &kp F11             &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&none  &kp F1  &kp F2  &kp F3  &kp F10             &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&none  &none   &none   &none   &none    &none      &none         &none         &none         &none         &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        SYMBOL {
            bindings = <
&kp PRINTSCREEN  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &none             &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON   &kp COLON
&none            &kp DOLLAR       &kp PERCENT   &kp CARET             &none             &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT         &kp DOUBLE_QUOTES
&none            &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &none             &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDERSCORE  &kp BACKSLASH
&none            &none            &none         &none                 &none  &none      &none      &none                 &none                  &none           &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans              &studio_unlock  &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &kp LC(V)  &trans              &trans               &trans     &trans
&trans  &trans  &trans  &trans  &trans              &kp LC(C)  &mkp LCLK           &mkp MCLK            &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans              &kp LC(X)  &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans              &trans               &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_7 {
            bindings = <
&kp LC(Z)  &kp LC(Y)    &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &screenshot  &kp LC(INS)  &kp LS(INS)  &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
